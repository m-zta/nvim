# ── macOS ───────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editor backups / swap / undo ────────────────────────
*.swp
*.swo
*.swx
*.swn
*.tmp
*.bak
*~
.netrwhist
tags

# ── Neovim runtime artifacts (in case anything leaks in) ──
# lazy.nvim, mason, treesitter parsers, etc. live in stdpath("data"),
# not in the repo, but ignore these paths defensively if they ever appear:
/lazy/
/mason/
/site/
/shada/
/log/

# ── Local-only Lua dropins ──────────────────────────────
# If you ever add machine-specific overrides, conventionally named:
lua/local.lua
lua/mario/local/

# ── AI / context exports ────────────────────────────────
codebase.md
codebase.txt
nvim.txt
repomix-output.*
.aidigest

# ── OS / IDE noise (in case you peek with another editor) ─
.idea/
.vscode/
*.iml

# ── Notes ───────────────────────────────────────────────
# IMPORTANT: do NOT ignore lazy-lock.json — it pins plugin versions
# for reproducible installs across machines.
